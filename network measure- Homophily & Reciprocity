#Homophily

library(reshape2)
library(ggplot2)

df_hom <- data.frame(
  Round = 1:40,
  homophily_results
)

colnames(df_hom) <- c(
  "Round",
  paste0("Game",1:NoGames)
)

df_hom_long <- melt(
  df_hom,
  id.vars="Round"
)

ggplot(
  df_hom_long,
  aes(
    x=Round,
    y=value,
    colour=variable
  )
)+
  geom_line(linewidth=1.2)+
  geom_point(size=2)+
  theme_classic()+
  labs(
    y="Homophily Index",
    colour="Game"
  )


