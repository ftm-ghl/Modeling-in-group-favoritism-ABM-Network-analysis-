# Density 

library(igraph)

density_results <- matrix(
  NA,
  nrow=40,
  ncol=NoGames
)

for(game in 1:NoGames){

  for(round in 1:40){

    g <- graph_from_adjacency_matrix(
      CumulativeAdjacencyMatrices[[game]][[round]],
      mode="directed",
      weighted=TRUE,
      diag=FALSE
    )

    density_results[round,game] <-
      edge_density(g)

  }

}


