##plot 

library(tidyverse)

plot_degree_groups <- function(df, game_name){

  df_long <- df %>%
    select(
      player,
      in_degree_ingroup,
      in_degree_outgroup,
      out_degree_ingroup,
      out_degree_outgroup
    ) %>%
    pivot_longer(
      -player,
      names_to = "measure",
      values_to = "value"
    )

  ggplot(
    df_long,
    aes(
      x = factor(player),
      y = value,
      fill = measure
    )
  ) +
    geom_col(position = "dodge") +
    theme_minimal(base_size = 14) +
    labs(
      title = game_name,
      x = "Player",
      y = "Weighted Degree"
    )

}

