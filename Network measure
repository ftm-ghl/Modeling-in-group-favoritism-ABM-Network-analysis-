### Heatmap

library(reshape2)

plot_heatmap <- function(adj_matrix){

  df <- melt(adj_matrix)

  ggplot(
    df,
    aes(
      Var2,
      Var1,
      fill = value
    )
  ) +

    geom_tile() +

    scale_fill_gradient(
      low = "white",
      high = "darkred"
    ) +

    theme_minimal() +

    labs(
      x = "Receiver",
      y = "Sender",
      fill = "Tokens"
    )

}


plot_heatmap(
  CumulativeAdjacencyMatrices[[1]][[40]]
)

